                  <Button fx:id="botaoConfirmar" mnemonicParsing="false" onAction="#onConfirmarClicado" prefHeight="30.0" prefWidth="95.0" text="Confirmar" />
                  <Button fx:id="botaoVoltar" mnemonicParsing="false" onAction="#onVoltarClicado" prefHeight="30.0" prefWidth="94.0" text="Voltar" />
