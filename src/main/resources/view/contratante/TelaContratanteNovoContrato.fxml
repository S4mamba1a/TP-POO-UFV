                <ColumnConstraints hgrow="SOMETIMES" maxWidth="160.20001220703125" minWidth="10.0" prefWidth="128.80003662109374" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="240.79996337890628" minWidth="10.0" prefWidth="240.79996337890628" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label prefHeight="34.0" prefWidth="125.0" text="Cliente:" />
                  <Label prefHeight="34.0" prefWidth="125.0" text="Palhaço:" GridPane.rowIndex="1" />
                  <Label prefHeight="34.0" prefWidth="182.0" text="Instrumento:" GridPane.rowIndex="2" />
                  <Label prefHeight="34.0" prefWidth="125.0" text="Prazo final do pedido:" GridPane.rowIndex="3" />
                  <Label prefHeight="30.0" prefWidth="192.0" text="Valor total:" GridPane.rowIndex="4" />
                  <ComboBox fx:id="comboCliente" prefHeight="34.0" prefWidth="236.0" promptText="Escolha o Cliente" GridPane.columnIndex="1" />
                  <ComboBox fx:id="comboPalhaco" onAction="#onPalhacoSelecionado" prefHeight="34.0" prefWidth="236.0" promptText="Escolha o Palhaço" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <ComboBox fx:id="comboInstrumento" onAction="#onInstrumentoSelecionado" prefHeight="34.0" prefWidth="236.0" promptText="Escolha o Instrumento" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label fx:id="rotuloValorTotal" prefHeight="34.0" prefWidth="276.0" text="Valor total" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <DatePicker fx:id="campoDataFinal" prefHeight="34.0" prefWidth="236.0" promptText="Escolha Data" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               </children>
            </GridPane>
            <HBox layoutX="227.0" layoutY="492.0" prefHeight="30.0" prefWidth="598.0" spacing="55.0">
