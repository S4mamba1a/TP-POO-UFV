<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane prefHeight="620" prefWidth="1000" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <GridPane hgap="10.0" vgap="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Nome" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="campoNome" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Data de nascimento" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <DatePicker fx:id="campoDataNascimento" GridPane.columnIndex="3" GridPane.rowIndex="0" />
            <TextField fx:id="campoDescricaoFisica" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Endereço" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="campoEndereco" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label text="Local de trabalho" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Descrição física" GridPane.rowIndex="1" />
            <TextField fx:id="campoLocalDeTrabalho" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
      </GridPane>
   </top>
   <center>
      <TableView fx:id="tabelaClientes" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colunaId" text="ID" />
            <TableColumn fx:id="colunaNome" text="Nome" />
            <TableColumn fx:id="colunaDataNascimento" text="Nascimento" />
            <TableColumn fx:id="colunaDescricaoFisica" text="Descrição fisica" />
            <TableColumn fx:id="colunaEndereco" text="Endereço" />
            <TableColumn fx:id="colunaLocalDeTrabalho" text="Local de trabalho" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#onCadastrarClicado" text="Cadastrar" />
            <Button mnemonicParsing="false" onAction="#onLimparClicado" text="Limpar" />
            <Button mnemonicParsing="false" onAction="#onVoltarClicado" text="Voltar" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
