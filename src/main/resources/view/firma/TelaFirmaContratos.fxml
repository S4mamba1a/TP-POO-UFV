<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane prefHeight="560.0" prefWidth="860.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <GridPane hgap="10.0" vgap="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label />
            <Label text="Cliente" GridPane.columnIndex="2" />

            <Label text="Palhaço" GridPane.rowIndex="1" />
            <Label prefHeight="18.0" prefWidth="96.0" text="Instrumento" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label text="Data final" GridPane.rowIndex="2" />
            <Label GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Contratante" />
            <ComboBox fx:id="comboContratante" onAction="#onContratanteSelecionado" prefHeight="26.0" prefWidth="190.0" promptText="Escolha o contratante" GridPane.columnIndex="1" />
            <ComboBox fx:id="comboInstrumento" onAction="#onInstrumentoSelecionado" prefHeight="26.0" prefWidth="190.0" promptText="Escolha o instrumento" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <DatePicker fx:id="campoDataFinal" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <ComboBox fx:id="comboPalhaco" onAction="#onPalhacoSelecionado" prefWidth="190.0" promptText="Escolha o palhaço" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label fx:id="rotuloValorTotal" text="Valor total: —" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <HBox prefHeight="0.0" prefWidth="200.0" GridPane.rowIndex="3">
               <children>
                  <Label text="Novo Status" />
               </children>
            </HBox>
            <ComboBox fx:id="comboNovoStatus" prefWidth="190.0" promptText="Status" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Button fx:id="botaoAtualizarStatus" mnemonicParsing="false" onAction="#onAtualizarStatusClicado" text="Atualizar Status" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <ComboBox fx:id="comboCliente" prefWidth="190.0" promptText="Escolha o cliente" GridPane.columnIndex="3" />
            <HBox prefHeight="12.0" prefWidth="200.0" GridPane.rowIndex="4">
               <children>
                  <Label text="Filtros" />
               </children>
            </HBox>
            <ComboBox fx:id="comboFiltroContratante" onAction="#onFiltroAlterado" prefWidth="190.0" promptText="Todos os contratantes" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <ComboBox fx:id="comboFiltroPalhaco" onAction="#onFiltroAlterado" prefWidth="190.0" promptText="Todos os palhaços" GridPane.columnIndex="2" GridPane.rowIndex="4" />
            <ComboBox fx:id="comboFiltroStatus" onAction="#onFiltroAlterado" prefWidth="190.0" promptText="Todos os status" GridPane.columnIndex="3" GridPane.rowIndex="4" />
            <Button mnemonicParsing="false" onAction="#onLimparFiltrosClicado" text="Limpar Filtros" GridPane.rowIndex="5" />
         </children>
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
      </GridPane>
   </top>
   <center>
      <TableView fx:id="tabelaContratos" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colunaId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colunaContratante" prefWidth="180.0" text="Contratante" />
            <TableColumn fx:id="colunaCliente" prefWidth="130.0" text="Cliente" />
            <TableColumn fx:id="colunaPalhaco" prefWidth="140.0" text="Palhaço" />
            <TableColumn fx:id="colunaInstrumento" prefWidth="134.0" text="Instrumento" />
            <TableColumn fx:id="colunaDataFinal" prefWidth="80.0" text="Data final" />
            <TableColumn fx:id="colunaStatus" prefWidth="75.0" text="Status" />
            <TableColumn fx:id="colunaValorTotal" prefWidth="75.0" text="Valor Total" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
         <children>
            <Button fx:id="teste" mnemonicParsing="false" onAction="#onNovoClicado" text="Novo" />
            <Button fx:id="botaoSalvar" mnemonicParsing="false" onAction="#onSalvarClicado" text="Salvar" />
            <Button fx:id="botaoRemover" mnemonicParsing="false" onAction="#onRemoverClicado" text="Remover" />
            <Button mnemonicParsing="false" onAction="#onVoltarClicado" text="Voltar" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
