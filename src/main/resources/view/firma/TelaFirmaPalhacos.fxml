<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="620" prefWidth="1000" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <GridPane hgap="10.0" vgap="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Nome" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="campoNome" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Data de nascimento" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <DatePicker fx:id="campoDataNascimento" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Label text="Personalidade" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="campoPersonalidade" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Cachê" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="campoCache" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label text="Nota" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label fx:id="rotuloNota" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Buscar nome" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="campoBuscaNome" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Buscar personalidade" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <TextField fx:id="campoBuscaPersonalidade" GridPane.columnIndex="3" GridPane.rowIndex="3" />

            <Label text="Cachê máximo" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="campoBuscaCacheMaximo" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <HBox spacing="8.0" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="4">
               <children>
                  <Button mnemonicParsing="false" onAction="#onBuscarClicado" text="Buscar" />
                  <Button mnemonicParsing="false" onAction="#onLimparBuscaClicado" text="Limpar busca" />
                  <Button mnemonicParsing="false" onAction="#onOrdenarPorNotaClicado" text="Ordenar por nota" />
               </children>
            </HBox>
         </children>
      </GridPane>
   </top>
   <center>
      <TableView fx:id="tabelaPalhacos" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colunaId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colunaNome" prefWidth="180.0" text="Nome" />
            <TableColumn fx:id="colunaDataNascimento" prefWidth="130.0" text="Nascimento" />
            <TableColumn fx:id="colunaPersonalidade" prefWidth="200.0" text="Personalidade" />
            <TableColumn fx:id="colunaCache" prefWidth="100.0" text="Cachê" />
            <TableColumn fx:id="colunaNota" prefWidth="80.0" text="Nota" />
         </columns>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#onNovoClicado" text="Novo" />
            <Button mnemonicParsing="false" onAction="#onSalvarClicado" text="Salvar" />
            <Button fx:id="botaoRemover" mnemonicParsing="false" onAction="#onRemoverClicado" text="Remover" />
            <Button mnemonicParsing="false" onAction="#onVoltarClicado" text="Voltar" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
