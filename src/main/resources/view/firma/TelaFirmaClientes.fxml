<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<!-- Sem fx:controller: o controller é definido via loader.setController(this) -->

<BorderPane prefHeight="620" prefWidth="1000" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <!-- Topo: formulário do cliente + filtro -->
    <top>
        <GridPane hgap="12" vgap="10">
            <padding>
                <Insets bottom="15" left="15" right="15" top="15" />
            </padding>

            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" />
                <ColumnConstraints maxWidth="234.0" minWidth="176.0" prefWidth="188.0" />
                <ColumnConstraints halignment="RIGHT" maxWidth="192.0" minWidth="111.0" prefWidth="137.0" />
                <ColumnConstraints maxWidth="307.0" minWidth="200.0" prefWidth="281.0" />
            </columnConstraints>

            <!-- Linha 0 -->
            <Label alignment="TOP_LEFT" text="Nome:" GridPane.columnIndex="0" GridPane.halignment="LEFT" GridPane.rowIndex="0" />
            <TextField fx:id="campoNome" prefHeight="26.0" prefWidth="170.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Data de nascimento:" GridPane.columnIndex="2" GridPane.halignment="LEFT" GridPane.rowIndex="0" />
            <DatePicker fx:id="campoDataNascimento" maxWidth="Infinity" prefHeight="26.0" prefWidth="274.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <!-- Linha 1 -->
            <Label text="Descrição física:" GridPane.columnIndex="0" GridPane.halignment="LEFT" GridPane.rowIndex="1" />
            <TextField fx:id="campoDescricaoFisica" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Endereço:" GridPane.columnIndex="2" GridPane.halignment="LEFT" GridPane.rowIndex="1" />
            <TextField fx:id="campoEndereco" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <!-- Linha 2 -->
            <Label text="Local de trabalho:" GridPane.columnIndex="0" GridPane.halignment="LEFT" GridPane.rowIndex="2" />
            <TextField fx:id="campoLocalDeTrabalho" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Contratante dono:" GridPane.columnIndex="2" GridPane.halignment="LEFT" GridPane.rowIndex="2" />
            <ComboBox fx:id="comboContratante" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="2" />

            <!-- Linha 3: filtro da tabela -->
            <Label text="Filtrar por contratante:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <ComboBox fx:id="comboFiltroContratante" maxWidth="Infinity" onAction="#onFiltroAlterado" promptText="Todos os contratantes" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Button onAction="#onLimparFiltroClicado" text="Limpar filtro" GridPane.columnIndex="2" GridPane.rowIndex="3" />
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </top>

    <!-- Centro: tabela -->
    <center>
        <TableView fx:id="tabelaClientes">
            <columns>
                <TableColumn fx:id="colunaId" prefWidth="50" text="Id" />
                <TableColumn fx:id="colunaNome" prefWidth="160" text="Nome" />
                <TableColumn fx:id="colunaDataNascimento" prefWidth="130" text="Data de nascimento" />
                <TableColumn fx:id="colunaDescricaoFisica" prefWidth="170" text="Descrição física" />
                <TableColumn fx:id="colunaEndereco" prefWidth="170" text="Endereço" />
                <TableColumn fx:id="colunaLocalDeTrabalho" prefWidth="150" text="Local de trabalho" />
                <TableColumn fx:id="colunaContratante" prefWidth="150" text="Contratante" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>

    <!-- Base: botões -->
    <bottom>
        <HBox alignment="CENTER" spacing="10">
            <padding>
                <Insets bottom="12" left="15" right="15" top="12" />
            </padding>
            <Button onAction="#onNovoClicado" text="Novo" />
            <Button onAction="#onSalvarClicado" text="Salvar" />
            <Button fx:id="botaoRemover" onAction="#onRemoverClicado" text="Remover" />
            <Button onAction="#onVoltarClicado" text="Voltar" />
        </HBox>
    </bottom>
</BorderPane>
