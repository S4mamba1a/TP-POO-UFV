<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane prefHeight="560.0" prefWidth="860.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <GridPane hgap="10.0" vgap="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Nota" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="campoValor" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Comentário" GridPane.rowIndex="1" />
            <TextArea fx:id="campoDescricao" prefHeight="34.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Filtrar palhaço" GridPane.rowIndex="2" />
            <ComboBox fx:id="comboFiltroPalhaco" onAction="#onFiltroAlterado" prefWidth="200.0" promptText="Todos os palhaços" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Button mnemonicParsing="false" onAction="#onLimparFiltroClicado" text="Limpar filtro" GridPane.columnIndex="3" GridPane.rowIndex="2" />
         </children>
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints minHeight="10.0" prefHeight="30.0" />
         </rowConstraints>
      </GridPane>
   </top>
   <center>
      <TableView fx:id="tabelaContratos" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colunaIdContrato" prefWidth="110.0" text="ID Contrato" />
            <TableColumn fx:id="colunaContratante" prefWidth="152.0" text="Contratante" />
            <TableColumn fx:id="colunaCliente" prefWidth="130.0" text="Cliente" />
            <TableColumn fx:id="colunaPalhaco" prefWidth="138.0" text="Palhaço" />
            <TableColumn fx:id="colunaStatus" prefWidth="124.0" text="Status" />
            <TableColumn fx:id="colunaNota" prefWidth="97.0" text="Nota" />
            <TableColumn fx:id="colunaComentario" prefWidth="107.0" text="Comentário" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#onSalvarClicado" text="Salvar" />
            <Button fx:id="botaoRemoverAvaliacao" mnemonicParsing="false" onAction="#onRemoverClicado" text="Remover avaliação" />
            <Button mnemonicParsing="false" onAction="#onVoltarClicado" text="Voltar" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
