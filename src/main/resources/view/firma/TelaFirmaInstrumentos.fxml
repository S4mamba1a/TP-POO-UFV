<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="620" prefWidth="1000" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <GridPane hgap="10.0" vgap="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Nome" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="campoNome" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Descrição" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="campoDescricao" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Label text="Valor" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="campoValor" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Palhaço dono" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <ComboBox fx:id="comboPalhacoDono" prefWidth="200.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label text="Filtrar por palhaço" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <ComboBox fx:id="comboFiltroPalhaco" onAction="#onFiltroAlterado" prefWidth="200.0" promptText="Todos os palhaços" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Button mnemonicParsing="false" onAction="#onLimparFiltroClicado" text="Limpar filtro" GridPane.columnIndex="2" GridPane.rowIndex="2" />
         </children>
      </GridPane>
   </top>
   <center>
      <TableView fx:id="tabelaInstrumentos" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colunaId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colunaNome" prefWidth="170.0" text="Nome" />
            <TableColumn fx:id="colunaDescricao" prefWidth="250.0" text="Descrição" />
            <TableColumn fx:id="colunaValor" prefWidth="100.0" text="Valor" />
            <TableColumn fx:id="colunaPalhacoDono" prefWidth="180.0" text="Palhaço dono" />
         </columns>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#onNovoClicado" text="Novo" />
            <Button mnemonicParsing="false" onAction="#onSalvarClicado" text="Salvar" />
            <Button fx:id="botaoRemover" mnemonicParsing="false" onAction="#onRemoverClicado" text="Remover" />
            <Button mnemonicParsing="false" onAction="#onVoltarClicado" text="Voltar" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
